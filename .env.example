# ==============================================================================
# SaathiShield AI — Environment Configuration Template (.env.example)
# ==============================================================================
# DO NOT commit real API keys or secrets to version control.
# Copy this file to .env for local backend execution: cp .env.example .env

# ------------------------------------------------------------------------------
# 1. AI Provider Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# Supported providers: "gemini", "openai", "none" (defaults to verified local RAG mode)
AI_PROVIDER=none

# Google Gemini API Configuration (if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (if AI_PROVIDER=openai or OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 2. Server & Rate Limiting Guardrails
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 3. Frontend Static Configuration (VITE_)
# ------------------------------------------------------------------------------
VITE_APP_NAME="SaathiShield AI"
VITE_APP_ENV="development"
VITE_OFFICIAL_1930_URL="https://cybercrime.gov.in"
VITE_SANCHAR_SAATHI_URL="https://sancharsaathi.gov.in"
